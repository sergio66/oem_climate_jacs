[Xnorm, muX, sigX] = normalize(X, 2);      % initial vectors
[Ynorm, muY, sigY] = normalize(Y, 2);      % targets (for reference)

% === Residual Learning: Predict correction Delta = Y - X ===
DeltaNorm = Ynorm - Xnorm;                 % This is what the network will learn

% === Create Multi-Channel Input (Channel 1 = X, Channels 2+ = P broadcasted) ===
numChannels = 1 + numParams;

XTrain = zeros(numChannels, vecLen, N, 'single');   % Channel x Length x Batch

