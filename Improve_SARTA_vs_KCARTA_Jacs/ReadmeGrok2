    XTrain(1, :, i) = Xnorm(:, i);                    % Main signal
    XTrain(2:end, :, i) = repmat(Pnorm(:, i), 1, vecLen);  % Broadcast parameters
end

% Target for training
YTrain = DeltaNorm;   % shape: [vecLen x N]

% Optional: Split into train/validation
idx = randperm(N);
trainIdx = idx(1:round(0.85*N));
valIdx   = idx(round(0.85*N)+1:end);

XTrainData = XTrain(:,:,trainIdx);
YTrainData = YTrain(:,trainIdx);

