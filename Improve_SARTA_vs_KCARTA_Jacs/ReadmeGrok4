%% prediction function predictScalarNN_Direct.m

function Y_pred = predictScalarNN_Direct(P_new, X_init)
    persistent Model
    
    if isempty(Model)
        load('MyScalarNN_Direct.mat', 'Model');
        disp('Direct ScalarNN model loaded.');
    end
    
    Pnorm = (P_new - Model.muP) ./ Model.sigP;
    Xnorm = (X_init - Model.muX) ./ Model.sigX;
    
    Input = [Pnorm; Xnorm];
    
    Ynorm_pred = predict(Model.net, Input);
    Y_pred = Ynorm_pred * Model.sigY + Model.muY;
end

