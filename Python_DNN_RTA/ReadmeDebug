    nnIdx = knnsearch(Xtrain, Xval, 'K', 1);
    minDist = sqrt(sum((Xval - Xtrain(nnIdx,:)).^2, 2));
    fprintf('Closest train-set neighbor distance for val samples: min %.4f, median %.4f\n', min(minDist), median(minDist));

